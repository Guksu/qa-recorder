{
  "name": "qa-recorder",
  "version": "1.13.0",
  "description": "One-click QA capture for web apps — rrweb DOM serialization, network logs, and console errors unified in one report.",
  "keywords": [
    "qa",
    "testing",
    "recording",
    "screen-capture",
    "network",
    "har",
    "debug",
    "bug-reporting"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/Guksu/qa-recorder#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guksu/qa-recorder.git"
  },
  "bugs": {
    "url": "https://github.com/Guksu/qa-recorder/issues"
  },
  "main": "./dist/qa-recorder.esm.js",
  "module": "./dist/qa-recorder.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/qa-recorder.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && rollup -c rollup.config.ts --configPlugin typescript",
    "dev": "rollup -c rollup.config.ts --configPlugin typescript --watch",
    "demo": "vite demo --host --config vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:package": "node scripts/verify-package.mjs",
    "test:e2e": "playwright test",
    "prepublishOnly": "pnpm test && pnpm build",
    "prepack": "cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.0.18",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "busboy": "^1.6.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.2",
    "har-schema": "^2.0.0",
    "jsdom": "^28.1.0",
    "rollup": "^4.0.0",
    "rrweb": "^1.1.3",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
