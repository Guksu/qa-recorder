{
  "name": "qa-recorder",
  "version": "0.1.0",
  "description": "QA recording library for web applications",
  "main": "./dist/qa-recorder.esm.js",
  "module": "./dist/qa-recorder.esm.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin typescript",
    "dev": "rollup -c rollup.config.ts --configPlugin typescript --watch",
    "demo": "vite demo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qa-recorder/shared": "workspace:*",
    "recordrtc": "^5.6.2"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/recordrtc": "^5.6.14",
    "rollup": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  }
}
