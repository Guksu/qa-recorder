{
  "name": "qa-recorder",
  "version": "1.1.1",
  "description": "One-click QA recording for web apps — screen video + network activity, all in the browser.",
  "keywords": [
    "qa",
    "testing",
    "recording",
    "screen-capture",
    "network",
    "har",
    "debug",
    "bug-reporting"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/Guksu/qa-recorder#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guksu/qa-recorder.git"
  },
  "bugs": {
    "url": "https://github.com/Guksu/qa-recorder/issues"
  },
  "main": "./dist/qa-recorder.esm.js",
  "module": "./dist/qa-recorder.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/qa-recorder.esm.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin typescript",
    "dev": "rollup -c rollup.config.ts --configPlugin typescript --watch",
    "demo": "vite demo --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "cp ../../README.md ./README.md && pnpm test && pnpm build"
  },
  "dependencies": {
    "rrweb": "^1.1.3"
  },
  "devDependencies": {
    "@qa-recorder/shared": "workspace:*",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "rollup": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
